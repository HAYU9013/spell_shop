graph TD

  %% ═════════════════════════════════════════
  %% COLOR LEGEND
  %% ⬛ unityBase  — Unity 基底 (MonoBehaviour, ScriptableObject)
  %% 🔵 iface      — 介面 (IRequirement, IGameState)
  %% 🟠 so         — ScriptableObject 資料定義
  %% 🟢 dataStruct — 純資料 / Struct
  %% 🩵 inst       — Runtime Instance
  %% 🟣 reqImpl    — IRequirement 實作
  %% 🟡 stateImpl  — IGameState 實作 (Turn Phase)
  %% 🔴 mgr        — MonoBehaviour Manager
  %% 🔷 util       — 工具類
  %% ═════════════════════════════════════════

  %% ─────────────────────────────────────────
  %% Unity Base
  %% ─────────────────────────────────────────
  subgraph UB[Unity Base Classes]
    MonoBehaviour["MonoBehaviour"]
    ScriptableObject["ScriptableObject"]
  end

  %% ─────────────────────────────────────────
  %% Interfaces
  %% ─────────────────────────────────────────
  subgraph IF[Interfaces]
    IRequirement["«interface»\nIRequirement\n+IsSatisfied()\n+GetProgressText()"]
    IGameState["«interface»\nIGameState\n+Enter()\n+Execute()\n+Exit()"]
  end

  %% ─────────────────────────────────────────
  %% ScriptableObjects
  %% ─────────────────────────────────────────
  subgraph SO[ScriptableObject — Data Definitions]
    CustomerData["CustomerData"]
    RelicData["RelicData"]
    RuneData["RuneData"]
    ScrollData["ScrollData"]
  end

  %% ─────────────────────────────────────────
  %% Data / Struct
  %% ─────────────────────────────────────────
  subgraph DS[Pure Data / Struct]
    EnvironmentData["EnvironmentData"]
    EnvironmentDelta["«struct»\nEnvironmentDelta"]
    RuneEffect["«struct»\nRuneEffect"]
    RequirementContext["RequirementContext"]
    RequirementData["RequirementData"]
    RelicCondition["RelicCondition"]
    RelicTickResult["RelicTickResult"]
    SubmitRecord["SubmitRecord"]
  end

  %% ─────────────────────────────────────────
  %% Runtime Instances
  %% ─────────────────────────────────────────
  subgraph INST[Runtime Instances]
    CustomerInstance["CustomerInstance"]
    RelicInstance["RelicInstance"]
    RuneInstance["RuneInstance"]
    ScrollInstance["ScrollInstance"]
  end

  %% ─────────────────────────────────────────
  %% IRequirement Implementations
  %% ─────────────────────────────────────────
  subgraph REQIMPL[IRequirement Implementations]
    AbsoluteRequirement["AbsoluteRequirement"]
    RelativeChangeRequirement["RelativeChangeRequirement"]
    StabilityRequirement["StabilityRequirement"]
    RequirementFactory["«static»\nRequirementFactory"]
  end

  %% ─────────────────────────────────────────
  %% IGameState Implementations
  %% ─────────────────────────────────────────
  subgraph STATES[IGameState Implementations — Turn Phases]
    CustomerArrivalState["❶ CustomerArrivalState"]
    RelicTriggerState["❷ RelicTriggerState"]
    DrawCardsState["❸ DrawCardsState"]
    PlayerActionState["❹ PlayerActionState"]
    EnvironmentResolveState["❺ EnvironmentResolveState"]
    CustomerJudgeState["❻ CustomerJudgeState"]
    PatienceCheckState["❼ PatienceCheckState"]
    RelicUpdateState["❽ RelicUpdateState"]
  end

  %% ─────────────────────────────────────────
  %% MonoBehaviour Managers
  %% ─────────────────────────────────────────
  subgraph MGR[MonoBehaviour Managers]
    GameManager["GameManager"]
    TurnManager["TurnManager"]
    CustomerManager["CustomerManager"]
    DeckManager["DeckManager"]
    EnvironmentManager["EnvironmentManager"]
    RelicManager["RelicManager"]
    ScrollInventory["ScrollInventory"]
    WorkbenchManager["WorkbenchManager"]
    SpriteMover["SpriteMover"]
  end

  %% ─────────────────────────────────────────
  %% Utility Classes
  %% ─────────────────────────────────────────
  subgraph UTIL[Utility Classes]
    ExtremeEventHandler["ExtremeEventHandler"]
    ScrollProcessor["«static»\nScrollProcessor"]
  end

  %% ═════════════════════════════════════════
  %% INHERITANCE  ==>  (extends)
  %% ═════════════════════════════════════════
  ScriptableObject ==>|extends| CustomerData
  ScriptableObject ==>|extends| RelicData
  ScriptableObject ==>|extends| RuneData
  ScriptableObject ==>|extends| ScrollData

  MonoBehaviour ==>|extends| GameManager
  MonoBehaviour ==>|extends| TurnManager
  MonoBehaviour ==>|extends| CustomerManager
  MonoBehaviour ==>|extends| DeckManager
  MonoBehaviour ==>|extends| EnvironmentManager
  MonoBehaviour ==>|extends| RelicManager
  MonoBehaviour ==>|extends| ScrollInventory
  MonoBehaviour ==>|extends| WorkbenchManager
  MonoBehaviour ==>|extends| SpriteMover

  %% ═════════════════════════════════════════
  %% INTERFACE IMPLEMENTATION  -.->  (implements)
  %% ═════════════════════════════════════════
  IRequirement -.->|implements| AbsoluteRequirement
  IRequirement -.->|implements| RelativeChangeRequirement
  IRequirement -.->|implements| StabilityRequirement

  IGameState -.->|implements| CustomerArrivalState
  IGameState -.->|implements| RelicTriggerState
  IGameState -.->|implements| DrawCardsState
  IGameState -.->|implements| PlayerActionState
  IGameState -.->|implements| EnvironmentResolveState
  IGameState -.->|implements| CustomerJudgeState
  IGameState -.->|implements| PatienceCheckState
  IGameState -.->|implements| RelicUpdateState

  %% ═════════════════════════════════════════
  %% COMPOSITION / AGGREGATION  -->  (has / owns)
  %% ═════════════════════════════════════════
  CustomerData -->|has| RequirementData
  RelicData -->|has| RelicCondition
  RelicData -->|has| RuneEffect
  RequirementContext -->|has| EnvironmentData
  RequirementContext -->|has| EnvironmentDelta
  SubmitRecord -->|has| ScrollData
  SubmitRecord -->|has| RuneData

  CustomerInstance -->|wraps| CustomerData
  CustomerInstance -->|has| EnvironmentData
  CustomerInstance -->|has| IRequirement
  RelicInstance -->|wraps| RelicData
  RuneInstance -->|wraps| RuneData
  ScrollInstance -->|wraps| ScrollData

  AbsoluteRequirement -->|uses| RequirementData
  RelativeChangeRequirement -->|uses| RequirementData
  StabilityRequirement -->|uses| RequirementData
  RequirementFactory -.->|creates| IRequirement

  GameManager -->|owns| TurnManager
  GameManager -->|refs| CustomerData
  GameManager -->|refs| RuneData
  GameManager -->|refs| ScrollData
  GameManager -->|refs| RelicData

  TurnManager -->|owns| IGameState

  CustomerManager -->|owns| CustomerInstance
  CustomerManager -->|refs| CustomerData
  CustomerManager -.->|uses| EnvironmentManager

  DeckManager -->|owns| RuneInstance

  EnvironmentManager -->|owns| EnvironmentData
  EnvironmentManager -->|owns| ExtremeEventHandler

  RelicManager -->|owns| RelicInstance
  RelicManager -.->|uses| EnvironmentManager

  WorkbenchManager -->|owns| RuneInstance
  WorkbenchManager -->|owns| SubmitRecord
  WorkbenchManager -->|refs| ScrollData
  WorkbenchManager -.->|uses| DeckManager
  WorkbenchManager -.->|ref| TurnManager

  ScrollProcessor -.->|uses| EnvironmentData
  ScrollProcessor -.->|uses| RuneInstance

  CustomerArrivalState -.->|ref| TurnManager
  RelicTriggerState -.->|ref| TurnManager
  DrawCardsState -.->|ref| TurnManager
  PlayerActionState -.->|ref| TurnManager
  EnvironmentResolveState -.->|ref| TurnManager
  CustomerJudgeState -.->|ref| TurnManager
  PatienceCheckState -.->|ref| TurnManager
  RelicUpdateState -.->|ref| TurnManager

  %% ═════════════════════════════════════════
  %% NODE COLORS (classDef)
  %% ═════════════════════════════════════════
  classDef unityBase  fill:#2e2e4e,stroke:#8888cc,color:#ddddff
  classDef iface      fill:#0d4f6e,stroke:#44aadd,color:#cceeff
  classDef so         fill:#5c3800,stroke:#cc8833,color:#ffe0aa
  classDef dataStruct fill:#1a3d2b,stroke:#44aa77,color:#aaffcc
  classDef inst       fill:#1e4d1e,stroke:#55bb55,color:#ccffcc
  classDef reqImpl    fill:#4a1a4a,stroke:#bb55bb,color:#ffccff
  classDef stateImpl  fill:#5c3c00,stroke:#ddaa33,color:#fff0bb
  classDef mgr        fill:#5a0a0a,stroke:#dd4444,color:#ffcccc
  classDef util       fill:#1a3a4a,stroke:#4499bb,color:#bbddee

  %% ⬛ Unity Base
  class MonoBehaviour,ScriptableObject unityBase

  %% 🔵 Interfaces
  class IRequirement,IGameState iface

  %% 🟠 ScriptableObjects
  class CustomerData,RelicData,RuneData,ScrollData so

  %% 🟢 Data / Struct
  class EnvironmentData,EnvironmentDelta,RuneEffect,RequirementContext,RequirementData,RelicCondition,RelicTickResult,SubmitRecord dataStruct

  %% 🩵 Instances
  class CustomerInstance,RelicInstance,RuneInstance,ScrollInstance inst

  %% 🟣 IRequirement Implementations
  class AbsoluteRequirement,RelativeChangeRequirement,StabilityRequirement,RequirementFactory reqImpl

  %% 🟡 IGameState Implementations
  class CustomerArrivalState,RelicTriggerState,DrawCardsState,PlayerActionState,EnvironmentResolveState,CustomerJudgeState,PatienceCheckState,RelicUpdateState stateImpl

  %% 🔴 Managers
  class GameManager,TurnManager,CustomerManager,DeckManager,EnvironmentManager,RelicManager,ScrollInventory,WorkbenchManager,SpriteMover mgr

  %% 🔷 Utilities
  class ExtremeEventHandler,ScrollProcessor util

  %% ─────────────────────────────────────────
  %% SUBGRAPH BACKGROUND COLORS
  %% ─────────────────────────────────────────
  style UB      fill:#e8e8f8,stroke:#8888cc
  style IF      fill:#d0eef8,stroke:#44aadd
  style SO      fill:#f5e8d0,stroke:#cc8833
  style DS      fill:#d0ead8,stroke:#44aa77
  style INST    fill:#d8ead8,stroke:#55bb55
  style REQIMPL fill:#ead0ea,stroke:#bb55bb
  style STATES  fill:#f5ebc8,stroke:#ddaa33
  style MGR     fill:#f5d0d0,stroke:#dd4444
  style UTIL    fill:#d0e4ea,stroke:#4499bb
